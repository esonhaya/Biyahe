# Copy to deploy/staging/.env on the external Linux staging host and chmod 0600.
# Do not place credential values here. Create secret files with mode 0600.
STAGING_HTTP_PORT=8080
STAGING_ALLOWED_HOSTS=localhost 127.0.0.1
APP_URL=http://localhost:8080

APP_ENV=staging
APP_DEBUG=false
APP_KEY_SECRET_FILE=./secrets/app_key
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=biyahe_staging
DB_USERNAME=biyahe_app
DB_PASSWORD_SECRET_FILE=./secrets/db_app_password
DB_ADMIN_USERNAME=biyahe_admin
DB_ADMIN_PASSWORD_SECRET_FILE=./secrets/db_admin_password
BIYAHE_OFFLINE_WALKING_PREVIEW=false
BIYAHE_API_INTERNAL_URL=http://gateway/api/v1
CORS_ALLOWED_ORIGINS=

# Required by the bootstrap script before migration/import mutations.
BIYAHE_STAGING_BACKUP_FILE=
BIYAHE_STAGING_BACKUP_SHA256=

# Public browser calls stay same-origin through the gateway.
NEXT_PUBLIC_API_URL=/api/v1
LOG_LEVEL=info
