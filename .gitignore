.composer.phar
.env
.env.*
!.env.example
!.env.testing.example
*.pem
*.key

# Laravel
/api/vendor/
/api/.env
/api/.env.*
!/api/.env.example
!/api/.env.testing.example
/api/bootstrap/cache/*.php
/api/storage/*.key
/api/storage/app/private/
/api/storage/framework/cache/data/*
/api/storage/framework/sessions/*
/api/storage/framework/views/*
/api/storage/logs/*.log
/api/public/build/
/api/public/css/filament/
/api/public/fonts/
/api/public/js/filament/
/api/.phpunit.result.cache

# Local agent metadata generated by development tools
/api/.agents/
/api/.claude/
/api/.codex/
/api/.mcp.json
/api/AGENTS.md
/api/CLAUDE.md

# Next.js
/web/node_modules/
/web/.next/
/web/out/
/web/coverage/
/web/.env.local
/web/.env.*.local
!/web/.env.example
/web/tsconfig.tsbuildinfo

